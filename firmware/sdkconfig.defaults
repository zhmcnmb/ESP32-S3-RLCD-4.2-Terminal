# 目标芯片: ESP32-S3-WROOM-1-N16R8 (16MB Flash, 8MB PSRAM Octal)
CONFIG_IDF_TARGET="esp32s3"

# Flash
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# PSRAM: N16R8变体为Octal SPI PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

# CPU满频240MHz: 后续LVGL刷屏与ESP-SR语音推理需要
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# 启动期会串行完成SD恢复、agent初始化与语音编排；默认3584B在memory_writer接入后
# 真机触发main任务栈溢出，提升到4096B保留可观测余量。
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096

# 自定义分区表: app扩到4MB(默认1MB光WiFi就占83%)，并预留语音模型分区
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# FATFS: 支持长文件名与exFAT。大容量SD卡(>32GB)默认格式化为exFAT，
# 不开这个选项会挂载失败(报ESP_FAIL)
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_USE_FASTSEEK=y

# 默认日志级别
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# ESP-SR (P5.1->P5.2): 中文发音"Jarvis"无官方WakeNet指纹模型(50+条目表核对过，
# 没有匹配"贾维斯"发音的条目)，改用MultiNet单命令词识别(mn5q8_cn)持续监听，
# 自定义命令词"贾维斯"(拼音 jia wei si)替代WakeNet作为唤醒网关。
# 权衡：MultiNet是官方设计给"唤醒后识别一句命令"用的重量级模型，非WakeNet
# 那种为常驻低功耗监听调优的指纹模型，连续跑存在更高CPU/误唤醒风险，
# 需真机长时间验证阈值是否够用(docs/voice-agent-design.md 第9.4节记录决策)
CONFIG_MODEL_IN_FLASH=y
CONFIG_AFE_INTERFACE_V1=y
CONFIG_SR_NSN_WEBRTC=y
CONFIG_SR_VADN_WEBRTC=y
CONFIG_SR_MN_CN_MULTINET5_RECOGNITION_QUANT8=y
CONFIG_CN_SPEECH_COMMAND_ID0="jia wei si"
# esp-sr给这个模型预置了19条示例命令词(打开空调/蓝牙等)当Kconfig默认值，
# 不清空的话会跟"贾维斯"一起进解码词表，白白稀释目标短语的识别精度
CONFIG_CN_SPEECH_COMMAND_ID1=""
CONFIG_CN_SPEECH_COMMAND_ID2=""
CONFIG_CN_SPEECH_COMMAND_ID3=""
CONFIG_CN_SPEECH_COMMAND_ID4=""
CONFIG_CN_SPEECH_COMMAND_ID5=""
CONFIG_CN_SPEECH_COMMAND_ID6=""
CONFIG_CN_SPEECH_COMMAND_ID7=""
CONFIG_CN_SPEECH_COMMAND_ID8=""
CONFIG_CN_SPEECH_COMMAND_ID9=""
CONFIG_CN_SPEECH_COMMAND_ID10=""
CONFIG_CN_SPEECH_COMMAND_ID11=""
CONFIG_CN_SPEECH_COMMAND_ID12=""
CONFIG_CN_SPEECH_COMMAND_ID13=""
CONFIG_CN_SPEECH_COMMAND_ID14=""
CONFIG_CN_SPEECH_COMMAND_ID15=""
CONFIG_CN_SPEECH_COMMAND_ID16=""
CONFIG_CN_SPEECH_COMMAND_ID17=""
CONFIG_CN_SPEECH_COMMAND_ID18=""
CONFIG_CN_SPEECH_COMMAND_ID19=""

# esp-sr的libfst.a(MultiNet命令词文本归一化)是用经典newlib ABI预编译的，
# 引用了`_ctype_`符号；IDF v6默认libc改成了picolibc，没有这个符号会链接失败
# (undefined reference to `_ctype_`)。切回newlib满足这个预编译库的ABI假设
CONFIG_LIBC_NEWLIB=y

# wakeword task(WakeNet推理)固定跑CPU1，持续占用CPU是AI推理设计使然，
# 不是hang——真机验证时IDLE1因此拿不到5秒累计空闲时间触发task watchdog
# 误报。CPU0(WiFi/lwIP协议栈+其余业务task)的IDLE0检查保留，用于捕获
# 真实死锁
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n

