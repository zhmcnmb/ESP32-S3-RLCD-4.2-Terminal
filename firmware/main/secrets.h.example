#pragma once

#define WIFI_SSID     "你的WiFi名称"
#define WIFI_PASSWORD "你的WiFi密码"

/* 时区: 中国标准时间(UTC+8)。POSIX格式，符号与直觉相反是正常的 */
#define TIMEZONE "CST-8"


/* 天气(P3)：设备直连QWeather(TLS证书链+ROM miniz解gzip已在
 * cloud_transport组件实现)。注册: https://dev.qweather.com
 * QWEATHER_API_HOST 是控制台分配的项目专属域名(不含协议前缀)，QWEATHER_LOCATION
 * 是城市LocationID */
#define QWEATHER_API_KEY  "你的和风天气API Key"
#define QWEATHER_API_HOST "xxxxx.re.qweatherapi.com"
#define QWEATHER_LOCATION "101010100"

/* P5.0 云 API(ASR/LLM/TTS)。设备直连，Bearer Header 认证。
 * SiliconFlow(ASR+TTS+LLM均可): https://cloud.siliconflow.cn 控制台 -> API密钥
 * DeepSeek(仅LLM，可选，用于 llm_provider 切换验证；留空字符串则固件只走 SiliconFlow LLM) */
#define SILICONFLOW_API_KEY "你的SiliconFlow API Key"
#define DEEPSEEK_API_KEY    "你的DeepSeek API Key（可选，不用则留空字符串）"

/* P6.1 Web：联网检索已完全免Key（Bing搜索 + 白名单URL直连抓取正文），无需任何配置。 */
