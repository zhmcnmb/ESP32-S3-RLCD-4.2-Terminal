/* 复制本文件为 secrets.h 并填入真实凭证。
 * secrets.h 已被 .gitignore 排除，不会进仓库。
 *
 *   cp main/secrets.h.example main/secrets.h
 */
#pragma once

#define WIFI_SSID     "你的WiFi名称"
#define WIFI_PASSWORD "你的WiFi密码"

/* 时区: 中国标准时间(UTC+8)。POSIX格式，符号与直觉相反是正常的 */
#define TIMEZONE "CST-8"

/* 桥接服务(bridge/server.py)，P3天气+P4 Claude用量都走这里代理。BRIDGE_MDNS_HOST
 * 不含".local"后缀，是跑桥接服务那台Mac的mDNS主机名，`scutil --get LocalHostName`查看。
 *
 * 和风天气凭据(API Key/Host/LocationID)不配在这里——配在 bridge/config.local.json，
 * 注册: https://dev.qweather.com ，模板见 bridge/config.local.json.example */
#define BRIDGE_MDNS_HOST "你的Mac主机名"
#define BRIDGE_PORT 8787
